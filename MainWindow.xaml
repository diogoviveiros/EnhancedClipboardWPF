<Window x:Class="EnhancedClipboardWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:EnhancedClipboardWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="420" Width="360"
        Visibility="Hidden"
        ResizeMode="NoResize"
        Background="#282828"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Grid>

        <Grid MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >

                <Border BorderThickness="1" BorderBrush="#9b9b9b" CornerRadius="1" Padding="1" Width="34" Background="#9b9b9b" Margin="0,0,114,0" 
        HorizontalAlignment="Center" VerticalAlignment="Center"/>


                <Button x:Name="btnClose" Content="X"  WindowChrome.IsHitTestVisibleInChrome="True"  Width="50" Height="40" BorderBrush="#282828" BorderThickness="0" Foreground="#FFFFFF" 
                        Click="btnClose_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Background" Value="#282828"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                </Button>
                
                


            </StackPanel>


        </Grid>


        <StackPanel Orientation="Vertical" Margin="0,45,0,0">

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2">

                <ListView
                    x:Name="SavedClipboardList"  
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Width="350"
                    Height="380"
                    Background="#282828"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    >


                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="BorderBrush" Value="LightGray" />
                            <Setter Property="BorderThickness" Value="1,1,1,1" />
                            <Setter Property="Margin" Value="20, 0, 20, 5" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SavedClipboardList_ItemClick"/>

                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>



                            <StackPanel Orientation="Horizontal" Height="75">


                                <StackPanel Orientation="Horizontal" Width="276" HorizontalAlignment="Stretch" MouseLeftButtonDown="SavedClipboardList_ItemClick">
                                    
                                    <Image Source= "/Assets/Placeholder.png" HorizontalAlignment="Left"/>
                                    <TextBlock Text= "{Binding body}" FontWeight="Bold" Foreground="#ffffff"/>
               
                                </StackPanel>

                                <Border BorderThickness="0.5" Grid.Row="0" Grid.ColumnSpan="2"
                                        CornerRadius="0,0,0,0" BorderBrush="White" Background="White">
                                </Border>

                                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Width="Auto">
                                    <Button BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" Click="OpenEditWindow">...</Button>
                                    <Button BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" Click="RaiseListPriority">↑</Button>
                                    <Button BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" Click="LowerListPriority">↓</Button>
                                    <Button BorderThickness="0" Background="Transparent" Foreground="#FFFFFF" Click="btnRemove_Click">X</Button>

                                    <StackPanel.Resources>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Margin" Value="8,0,0,0"/>
                                        </Style>
                                    </StackPanel.Resources>

                                </StackPanel>

                            </StackPanel>





                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>




            </StackPanel>

        </StackPanel>



    </Grid>


</Window>
