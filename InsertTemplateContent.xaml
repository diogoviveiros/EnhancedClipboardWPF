<Window x:Class="EnhancedClipboardWPF.InsertTemplateContent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnhancedClipboardWPF"
        mc:Ignorable="d"
        Title="InsertTemplateContent" Height="250" Width="800"
        Background="#282828"
        ResizeMode="NoResize"
        WindowStyle="None">
    
    <Grid>

        <StackPanel Orientation="Vertical">
            <ListView x:Name="TemplatesView" Background="#282828" BorderThickness="0" HorizontalContentAlignment="Stretch" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Width="800"
                      Height="200">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="BorderBrush" Value="LightGray" />
                    <Setter Property="BorderThickness" Value="1,1,1,1" />
                    <Setter Property="Margin" Value="20, 0, 20, 5" />
                    <Setter Property="Focusable" Value="false"/>
                </Style>
                    
                </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Label Content= "{Binding inputName}" FontWeight="Bold" Foreground="#ffffff"/>
                            <TextBox x:Name="inputText" Width="765"  Margin="5,0,0,0" Text="{Binding input}"/>
                    </StackPanel>
                    
                </DataTemplate>
                
            </ListView.ItemTemplate>

            <ListView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                   Color="Transparent"/>
            </ListView.Resources>


            </ListView>


            <StackPanel Orientation="Horizontal" Margin="295,0,0,0">
        <Button x:Name="ButtonOK" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="92" Click="ButtonOK_Click" >
            <StackPanel Orientation="Horizontal">
                <TextBlock>OK</TextBlock>
                <Image Height="16" Width="16" Margin="10,0,0,0"/>
            </StackPanel>
        </Button>
                <Button x:Name="ButtonCancel" HorizontalAlignment="Left" Height="30" Margin="30,0,0,0" VerticalAlignment="Top" Width="92" Click="ButtonCancel_Click" >
            <StackPanel Orientation="Horizontal">
                <TextBlock>Cancel</TextBlock>
                <Image Height="16" Width="16" Margin="0,0,0,0"/>
            </StackPanel>
        </Button>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
