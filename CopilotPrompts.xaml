<Window x:Class="EnhancedClipboardWPF.CopilotPrompts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnhancedClipboardWPF"
        mc:Ignorable="d"
        Title="CopilotPrompts" Height="450" Width="800"
        Background="#282828"
        WindowStyle="None">


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Grid>

        <Grid MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>

            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >

                <Border BorderThickness="1" BorderBrush="#9b9b9b" CornerRadius="1" Padding="1" Width="150" Background="#9b9b9b" Margin="0,0,275,0" 
HorizontalAlignment="Center" VerticalAlignment="Center"/>


                <Button x:Name="btnClose" Content="X"  WindowChrome.IsHitTestVisibleInChrome="True"  Width="50" Height="40" BorderBrush="#282828" BorderThickness="0" Foreground="#FFFFFF" 
                Click="btnClose_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Background" Value="#282828"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                </Button>




            </StackPanel>


        </Grid>
        
        <StackPanel>
            <ScrollViewer Margin="15,42,15,0" Height="350" ScrollViewer.VerticalScrollBarVisibility="Hidden"
ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView ItemsSource="{Binding YourSource}" Name="listView"
                          BorderThickness="0"
                          HorizontalContentAlignment="Stretch"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Title}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Info}" />
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <Button Margin="15,8,15,0" Click="clipboardCopy_Click"> Copy to Clipboard </Button>
        <Button Margin="15,5,15,0" Click="saveTemplate_Click"> Save as Template  </Button>

        </StackPanel>

    </Grid>
</Window>
